# Copy to .env in this directory, or to ~/.config/screen-solver/.env — the
# latter is the one the packaged Screen Solver.app can also read, since it
# runs from inside its bundle and cannot find your checkout. A checkout .env
# wins where both exist.
#
# ── Credentials ────────────────────────────────────────────────────────
# You do NOT need an API key. The easiest path is a browser sign-in:
#
#     ./run.sh login          (or click "sign in" in the dashboard)
#
# That stores an OAuth profile under ~/.config/anthropic/ which the SDK
# picks up automatically and refreshes on its own.
#
# Only uncomment this if you'd rather use a static key. A key set here
# OVERRIDES the browser sign-in — including an empty or placeholder one.
# ANTHROPIC_API_KEY=sk-ant-...

# ── Local / self-hosted models ─────────────────────────────────────────
# Run against your own hardware instead of the Anthropic API — no key, no
# billing. Anything that speaks the OpenAI chat API works: Ollama, LM Studio,
# llama.cpp, vLLM, Jan.
#
# The quickest path (macOS):
#
#     brew install ollama && ollama serve
#     ollama pull qwen2.5vl:7b
#
# then uncomment BOTH lines below:
#
# SOLVER_PROVIDER=ollama
# SOLVER_MODEL=qwen2.5vl:7b
#
# The model MUST be a vision model — Screen Solver always sends a screenshot.
# Good picks, smallest first:
#     qwen2.5vl:7b      ~6 GB   solid all-rounder, reads code and tables well
#     gemma3:12b        ~8 GB   stronger prose, good at explaining
#     qwen2.5vl:32b     ~21 GB  closest to a hosted model, needs ~32 GB RAM
#     minicpm-v         ~5 GB   best pure OCR if screenshots are text-heavy
#
# SOLVER_PROVIDER also accepts: lmstudio, llamacpp, vllm, jan — or set
# SOLVER_BASE_URL yourself for anything else (including a paid OpenAI-
# compatible gateway, with SOLVER_API_KEY).
# SOLVER_BASE_URL=http://127.0.0.1:11434/v1
# SOLVER_API_KEY=
#
# Most local models cannot call tools, so page inspection is disabled
# automatically the first time the server rejects it. Force it either way:
# SOLVER_TOOLS=off
# Local models need a lower ceiling than Claude's 32k.
# SOLVER_MAX_TOKENS=4096
# SOLVER_TEMPERATURE=0.2

# ── Optional overrides ─────────────────────────────────────────────────
SOLVER_MODEL=claude-opus-5
# Anthropic only — local models have no effort setting.
SOLVER_EFFORT=xhigh
SOLVER_HOST=127.0.0.1
SOLVER_PORT=8787
# Display index (1-based) that screenshots are taken FROM.
SOLVER_CAPTURE_DISPLAY=1
# Seconds between polls when watch mode is on.
SOLVER_WATCH_INTERVAL=2.0
# Long edge (px) of the image sent to the API. Above ~1568 the API downscales anyway.
SOLVER_MAX_EDGE=1568
# How many captures to keep in shots/
SOLVER_KEEP_SHOTS=40
